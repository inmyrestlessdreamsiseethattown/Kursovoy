<svg xmlns="http://www.w3.org/2000/svg" width="900" height="1750" viewBox="0 0 900 1750" font-family="Arial, sans-serif" font-size="13">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L9,3 L0,6 z" fill="#333"/>
    </marker>
  </defs>
  <rect width="100%" height="100%" fill="#ffffff"/>

  <!-- Начало -->
  <ellipse cx="450" cy="40" rx="70" ry="25" fill="#d5e8d4" stroke="#82b366" stroke-width="2"/>
  <text x="450" y="45" text-anchor="middle">Начало</text>
  <line x1="450" y1="65" x2="450" y2="95" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- Ввод -->
  <polygon points="330,95 590,95 570,145 310,145" fill="#dae8fc" stroke="#6c8ebf" stroke-width="2"/>
  <text x="450" y="115" text-anchor="middle">Ввод 50 значений X</text>
  <text x="450" y="132" text-anchor="middle">(диапазон 5..70)</text>
  <line x1="450" y1="145" x2="450" y2="175" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- i=1 -->
  <rect x="380" y="175" width="140" height="40" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="450" y="200" text-anchor="middle">i = 1</text>
  <line x1="450" y1="215" x2="450" y2="245" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- Ввод X[i] -->
  <polygon points="355,245 565,245 545,295 335,295" fill="#dae8fc" stroke="#6c8ebf" stroke-width="2"/>
  <text x="450" y="275" text-anchor="middle">Ввод X[i]</text>
  <line x1="450" y1="295" x2="450" y2="325" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- Ввод корректен? -->
  <polygon points="450,325 550,375 450,425 350,375" fill="#fff2cc" stroke="#d6b656" stroke-width="2"/>
  <text x="450" y="375" text-anchor="middle">Ввод</text>
  <text x="450" y="390" text-anchor="middle">корректен?</text>
  <line x1="550" y1="375" x2="690" y2="375" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="615" y="368" text-anchor="middle" font-size="12">Нет</text>
  <line x1="450" y1="425" x2="450" y2="455" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="465" y="445" font-size="12">Да</text>

  <!-- Сообщение об ошибке ввода -->
  <polygon points="690,350 850,350 830,400 670,400" fill="#f8cecc" stroke="#b85450" stroke-width="2"/>
  <text x="760" y="380" text-anchor="middle">Сообщение</text>
  <text x="760" y="395" text-anchor="middle">об ошибке</text>
  <line x1="760" y1="400" x2="760" y2="430" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- Конец (return 1) -->
  <ellipse cx="760" cy="455" rx="80" ry="25" fill="#f8cecc" stroke="#b85450" stroke-width="2"/>
  <text x="760" y="460" text-anchor="middle">Конец (return 1)</text>

  <!-- 5 ≤ X ≤ 70? -->
  <polygon points="450,455 560,510 450,565 340,510" fill="#fff2cc" stroke="#d6b656" stroke-width="2"/>
  <text x="450" y="510" text-anchor="middle">5 ≤ X[i] ≤ 70 ?</text>
  <line x1="560" y1="510" x2="690" y2="510" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="620" y="503" text-anchor="middle" font-size="12">Нет</text>

  <!-- Сообщение вне диапазона -->
  <polygon points="690,485 850,485 830,535 670,535" fill="#f8cecc" stroke="#b85450" stroke-width="2"/>
  <text x="760" y="515" text-anchor="middle">Сообщение:</text>
  <text x="760" y="530" text-anchor="middle">вне диапазона</text>
  <line x1="760" y1="535" x2="760" y2="565" stroke="#333" stroke-width="1.5"/>
  <line x1="760" y1="565" x2="760" y2="455" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <line x1="450" y1="565" x2="450" y2="600" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="465" y="585" font-size="12">Да</text>

  <!-- q[i] = Q(X[i]) -->
  <rect x="355" y="600" width="190" height="45" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="450" y="627" text-anchor="middle">q[i] = Q(X[i])</text>
  <line x1="450" y1="645" x2="450" y2="680" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- i < 50? -->
  <polygon points="450,680 550,730 450,780 350,730" fill="#fff2cc" stroke="#d6b656" stroke-width="2"/>
  <text x="450" y="735" text-anchor="middle">i &lt; 50 ?</text>
  <line x1="550" y1="730" x2="680" y2="730" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="610" y="723" text-anchor="middle" font-size="12">Да</text>

  <!-- i=i+1 -->
  <rect x="680" y="710" width="100" height="40" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="730" y="735" text-anchor="middle">i = i + 1</text>
  <polyline points="730,710 730,260 570,260" fill="none" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <line x1="450" y1="780" x2="450" y2="820" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="465" y="805" font-size="12">Нет</text>

  <!-- Вывод шапки таблицы -->
  <polygon points="315,820 585,820 565,870 295,870" fill="#dae8fc" stroke="#6c8ebf" stroke-width="2"/>
  <text x="440" y="850" text-anchor="middle">Вывод шапки таблицы</text>
  <line x1="440" y1="870" x2="440" y2="900" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- i = 1 -->
  <rect x="370" y="900" width="140" height="40" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="440" y="925" text-anchor="middle">i = 1</text>
  <line x1="440" y1="940" x2="440" y2="970" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- Вывод строки -->
  <polygon points="290,970 590,970 570,1030 270,1030" fill="#dae8fc" stroke="#6c8ebf" stroke-width="2"/>
  <text x="430" y="995" text-anchor="middle">Вывод строки:</text>
  <text x="430" y="1015" text-anchor="middle">i, X[i], q[i], state_name(q[i])</text>
  <line x1="430" y1="1030" x2="430" y2="1060" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- i < 50? -->
  <polygon points="430,1060 530,1110 430,1160 330,1110" fill="#fff2cc" stroke="#d6b656" stroke-width="2"/>
  <text x="430" y="1115" text-anchor="middle">i &lt; 50 ?</text>
  <line x1="530" y1="1110" x2="660" y2="1110" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="590" y="1103" text-anchor="middle" font-size="12">Да</text>

  <!-- i=i+1 (вывод) -->
  <rect x="660" y="1090" width="100" height="40" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="710" y="1115" text-anchor="middle">i = i + 1</text>
  <polyline points="710,1090 710,990 590,990" fill="none" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <line x1="430" y1="1160" x2="430" y2="1200" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="445" y="1185" font-size="12">Нет</text>

  <!-- Статистика -->
  <polygon points="295,1200 565,1200 545,1250 275,1250" fill="#dae8fc" stroke="#6c8ebf" stroke-width="2"/>
  <text x="420" y="1230" text-anchor="middle">Вывод заголовка статистики</text>
  <line x1="420" y1="1250" x2="420" y2="1280" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- init min/max -->
  <rect x="350" y="1280" width="160" height="55" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="430" y="1300" text-anchor="middle">min_i = 16</text>
  <text x="430" y="1316" text-anchor="middle">max_i = 16, i = 17</text>
  <line x1="430" y1="1335" x2="430" y2="1365" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>

  <!-- i ≤ 27? -->
  <polygon points="430,1365 530,1415 430,1465 330,1415" fill="#fff2cc" stroke="#d6b656" stroke-width="2"/>
  <text x="430" y="1420" text-anchor="middle">i ≤ 27 ?</text>
  <line x1="530" y1="1415" x2="590" y2="1415" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="555" y="1408" text-anchor="middle" font-size="12">Да</text>

  <!-- q[i] < q[min_i]? -->
  <polygon points="590,1415 680,1465 590,1515 500,1465" fill="#fff2cc" stroke="#d6b656" stroke-width="2"/>
  <text x="590" y="1462" text-anchor="middle" font-size="12">q[i] &lt;</text>
  <text x="590" y="1476" text-anchor="middle" font-size="12">q[min_i]?</text>
  <line x1="680" y1="1465" x2="740" y2="1465" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="710" y="1458" text-anchor="middle" font-size="12">Да</text>

  <rect x="740" y="1445" width="100" height="40" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="790" y="1470" text-anchor="middle">min_i = i</text>

  <line x1="590" y1="1515" x2="590" y2="1545" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="600" y="1535" font-size="12">Нет</text>

  <!-- q[i] > q[max_i]? -->
  <polygon points="590,1545 680,1595 590,1645 500,1595" fill="#fff2cc" stroke="#d6b656" stroke-width="2"/>
  <text x="590" y="1592" text-anchor="middle" font-size="12">q[i] &gt;</text>
  <text x="590" y="1606" text-anchor="middle" font-size="12">q[max_i]?</text>
  <line x1="680" y1="1595" x2="740" y2="1595" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="710" y="1588" text-anchor="middle" font-size="12">Да</text>

  <rect x="740" y="1575" width="100" height="40" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="790" y="1600" text-anchor="middle">max_i = i</text>

  <line x1="590" y1="1645" x2="590" y2="1675" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="600" y="1665" font-size="12">Нет</text>

  <!-- i=i+1 -->
  <rect x="520" y="1675" width="140" height="40" fill="#f5f5f5" stroke="#666" stroke-width="2"/>
  <text x="590" y="1700" text-anchor="middle">i = i + 1</text>
  <polyline points="590,1675 590,1415 500,1415" fill="none" stroke="#333" stroke-width="1.5"/>

  <!-- Нет для i≤27 — вниз -->
  <line x1="430" y1="1465" x2="430" y2="1715" stroke="#333" stroke-width="1.5" marker-end="url(#arrow)"/>
  <text x="445" y="1500" font-size="12">Нет</text>

  <!-- Вывод результатов -->
  <polygon points="320,1715 540,1715 520,1765 300,1765" fill="#dae8fc" stroke="#6c8ebf" stroke-width="2"/>
  <text x="420" y="1745" text-anchor="middle">Вывод min, max, индексов</text>

  <!-- Нижний край: переносим Конец правее -->
  <line x1="420" y1="1765" x2="420" y2="1790" stroke="#333" stroke-width="1.5"/>
</svg>